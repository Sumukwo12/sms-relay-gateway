# ── Required ────────────────────────────────────────────────────────────────
# Public hostname; point its DNS A/AAAA record at this server
PHX_HOST=sms.example.com
# mix phx.gen.secret
SECRET_KEY_BASE=
# One key per internal system (keys >= 16 chars; mix phx.gen.secret 32)
API_KEYS=billing:replace-with-a-long-random-key,crm:another-long-random-key
# phone = SMS Relay app; uart = USB GSM modem
MODEM_ADAPTER=phone
PHONE_GATEWAY_TOKEN=

# ── Alerts (Slack/Discord incoming webhook, or any URL taking JSON) ─────────
ALERT_WEBHOOK_URL=
# ALERT_OFFLINE_SECONDS=300
# ALERT_QUEUE_AGE_SECONDS=600
# ALERT_BATTERY_PERCENT=20

# ── Limits and retention ────────────────────────────────────────────────────
# SMS parts per rolling 24h (a long message counts once per part)
DAILY_SEND_LIMIT=500
# MESSAGE_MAX_SEGMENTS=4
# MESSAGE_RETENTION_DAYS=30
# CODE_TTL_SECONDS=300

# The unauthenticated demo /api endpoints are off in production by default
# PUBLIC_API=false
# FRONTEND_ORIGIN=https://app.example.com
